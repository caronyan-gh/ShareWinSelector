<?xml version="1.0" encoding="utf-8"?>
<!--
  フレームワーク依存・単一ファイル（メインの配布物）
  exe 1 個・実行時の展開なし。動かすには .NET 10 Desktop Runtime が必要
  （未インストールなら起動時に .NET がダウンロード先を案内する）。
  dotnet publish src/ShareWinSelector -p:PublishProfile=FrameworkDependent
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\framework-dependent\</PublishDir>
  </PropertyGroup>
</Project>
