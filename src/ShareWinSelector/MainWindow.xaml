<Window x:Class="ShareWinSelector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShareWinSelector"
        xmlns:controls="clr-namespace:ShareWinSelector.Controls"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="ShareWinSelector" Width="1000" Height="660" MinWidth="300" MinHeight="260"
        Icon="Assets/app.ico"
        Background="{StaticResource BrandWindowBackgroundBrush}">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- ほかのモニターにあるウィンドウ（相手には見えていない）の薄さ -->
        <sys:Double x:Key="OtherMonitorOpacity">0.45</sys:Double>
        <Style x:Key="OtherMonitorDimRowStyle" TargetType="DockPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding OnSharedMonitor}" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource OtherMonitorOpacity}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OtherMonitorDimChipStyle" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding OnSharedMonitor}" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource OtherMonitorOpacity}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- モニターごとの区切り線「── DISPLAY2 ──」。共有するモニターのまとまり（一番上）には出さない -->
        <DataTemplate x:Key="MonitorGroupHeaderTemplate">
            <Grid x:Name="Root" Margin="0,8,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Height="1" Background="{StaticResource BrandBorderBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name.Label}" Margin="10,0" FontSize="11"
                           Foreground="{StaticResource BrandSubtleTextBrush}" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Height="1" Background="{StaticResource BrandBorderBrush}" VerticalAlignment="Center"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Name.IsShared}" Value="True">
                    <Setter TargetName="Root" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ヘッダーのアイコンボタン -->
        <!-- Fluent テーマのスタイルを継承しないとライト用の古い見た目になる -->
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="IconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <!-- サムネイルのカード（チェック状態でシアンの縁） -->
        <Style x:Key="ThumbCardStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <!-- テンプレートを自前で持つので文字色も明示する（未指定だと暗い既定色になり読めない） -->
            <Setter Property="Foreground" Value="#FFF0F4FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Card" Background="{StaticResource BrandPanelBrush}" BorderBrush="{StaticResource BrandBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FF1B233A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrandCyanBrush}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Card" Property="Padding" Value="7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- ほかのモニターにあるウィンドウは薄く（DWM のサムネイルも DwmThumbnails が同じ薄さにする） -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding OnSharedMonitor}" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource OtherMonitorOpacity}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 行ごとの「クロップ」: 量が未保存のアプリでは押せない（カーソルを乗せると作り方を出す） -->
        <Style x:Key="RowCropCheckStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="IsEnabled" Value="{Binding CanToggleCrop}"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTip" Value="{Binding [Crop_CheckTip], Source={x:Static local:Loc.Instance}}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ToolTip" Value="{Binding [Crop_CheckTipUnsaved], Source={x:Static local:Loc.Instance}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ThumbnailTemplate" DataType="{x:Type local:WindowItem}">
            <ToggleButton Style="{StaticResource ThumbCardStyle}" Width="212" Margin="0,0,10,10"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}" ToolTip="{Binding Display}">
                <StackPanel>
                    <!-- ここに DWM サムネイルが重なる -->
                    <Border Height="118" CornerRadius="6" Background="#FF080C18" Tag="{Binding Handle}"
                            Loaded="ThumbHost_Loaded" Unloaded="ThumbHost_Unloaded"/>
                    <DockPanel Margin="2,8,2,0">
                        <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                   Foreground="{StaticResource BrandCyanBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ProcessName}" Margin="2,2,2,0" FontSize="11"
                               Foreground="{StaticResource BrandSubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
                    <!-- このアプリのクロップ（「上をクロップ」がオンのときだけ） -->
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding CropUiVisible, Converter={StaticResource BoolToVisibility}}">
                        <Button DockPanel.Dock="Right" Content="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                Padding="6,2" MinHeight="0" MinWidth="0" Margin="4,0,0,0" Click="BringToFront_Click"
                                ToolTip="{Binding [Row_BringToFrontTip], Source={x:Static local:Loc.Instance}}"/>
                        <Button DockPanel.Dock="Right" Padding="8,1" MinHeight="0" FontSize="11" Click="CropAdjust_Click"
                                Content="{Binding [Crop_Adjust], Source={x:Static local:Loc.Instance}}"
                                ToolTip="{Binding [Crop_AdjustTip], Source={x:Static local:Loc.Instance}}"
                                Visibility="{Binding CropEnabled, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding CropEnabled, Mode=TwoWay}" MinHeight="0" FontSize="11" VerticalAlignment="Center"
                                      Style="{StaticResource RowCropCheckStyle}">
                                <CheckBox.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [Crop_Check], Source={x:Static local:Loc.Instance}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrandCyanBrush}"
                                                   ToolTip="{Binding [Crop_SavedTip], Source={x:Static local:Loc.Instance}}"
                                                   Visibility="{Binding HasSavedCrop, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </CheckBox.Content>
                            </CheckBox>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ToggleButton>
        </DataTemplate>

        <!-- 共有中ウィンドウのチップ（コンパクト表示） -->
        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type local:WindowItem}">
            <Border Background="#FF14304A" BorderBrush="{StaticResource BrandCyanBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="10,3,4,3" Margin="0,0,6,6" ToolTip="{Binding Display}"
                    Style="{StaticResource OtherMonitorDimChipStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button Content="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10" Padding="4" Margin="6,0,0,0"
                            MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                            ToolTip="{Binding [Row_BringToFrontTip], Source={x:Static local:Loc.Instance}}" Click="BringToFront_Click"/>
                    <Button Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" Padding="4" Margin="0"
                            MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                            ToolTip="{Binding [Chip_RemoveTip], Source={x:Static local:Loc.Instance}}" Click="ChipRemove_Click"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16,10,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー: ロゴ ＋ ピン留め・表示切替 -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;" Margin="0,0,8,0"
                        ToolTip="{Binding [Header_DesktopTip], Source={x:Static local:Loc.Instance}}" Click="Desktop_Click"/>
                <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggleStyle}" Content="&#xE77A;"
                              ToolTip="{Binding [Header_PinTip], Source={x:Static local:Loc.Instance}}"
                              Checked="PinButton_Changed" Unchecked="PinButton_Changed"/>
                <Button x:Name="ModeButton" Style="{StaticResource IconButtonStyle}" Content="&#xE73F;"
                        ToolTip="{Binding [Header_CompactTip], Source={x:Static local:Loc.Instance}}" Click="ModeButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Image x:Name="LogoImage" Source="Assets/logo.png" Height="44"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- 版（カーソルを乗せるとコミットまで） -->
                <TextBlock x:Name="VersionText" FontSize="11" Margin="6,0,0,4" VerticalAlignment="Bottom"
                           Foreground="{StaticResource BrandSubtleTextBrush}"/>
            </StackPanel>
        </DockPanel>

        <!-- 通常表示 -->
        <Grid x:Name="NormalView" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- 左: ウィンドウ選択 -->
            <Border Style="{StaticResource CardStyle}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton x:Name="MonitorOnlyButton" Style="{StaticResource IconToggleStyle}" Content="&#xE7F4;" Margin="0,0,12,0"
                                          ToolTip="{Binding [View_MonitorOnlyTip], Source={x:Static local:Loc.Instance}}" Checked="MonitorOnlyButton_Changed" Unchecked="MonitorOnlyButton_Changed"/>
                            <ToggleButton x:Name="ListViewButton" Style="{StaticResource IconToggleStyle}" Content="&#xE8FD;"
                                          ToolTip="{Binding [View_ListTip], Source={x:Static local:Loc.Instance}}" Click="ViewButton_Click"/>
                            <ToggleButton x:Name="ThumbViewButton" Style="{StaticResource IconToggleStyle}" Content="&#xE8A9;"
                                          ToolTip="{Binding [View_ThumbnailsTip], Source={x:Static local:Loc.Instance}}" Click="ViewButton_Click"/>
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Margin="12,0,0,0"
                                    ToolTip="{Binding [Refresh], Source={x:Static local:Loc.Instance}}" Click="Refresh_Click"/>
                            <Button x:Name="BringAllButton" Style="{StaticResource IconButtonStyle}" Content="&#xE8A7;"
                                    ToolTip="{Binding [BringAllToFrontTip], Source={x:Static local:Loc.Instance}}" Click="BringAllToFront_Click"/>
                            <Button x:Name="UncheckAllButton" Style="{StaticResource IconButtonStyle}" Content="&#xE894;"
                                    ToolTip="{Binding [UncheckAll], Source={x:Static local:Loc.Instance}}" Click="UncheckAll_Click"/>
                        </StackPanel>
                        <TextBlock Text="{Binding [Windows_Header], Source={x:Static local:Loc.Instance}}"
                                   Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- 共有のしかた（全体）。右端（全部外す ✕ の直下）には、全部外した直後だけ「元に戻す」が出る -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel x:Name="UndoBar" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="12,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="{Binding [Undo_Removed], Source={x:Static local:Loc.Instance}}" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource BrandSubtleTextBrush}"/>
                            <Button Margin="8,0,0,0" Padding="10,2" MinHeight="0" FontSize="12" Click="Undo_Click"
                                    Content="{Binding [Undo_Button], Source={x:Static local:Loc.Instance}}"/>
                        </StackPanel>
                        <WrapPanel>
                            <CheckBox x:Name="CropModeCheck" Margin="0,0,20,0" Checked="CropModeCheck_Changed" Unchecked="CropModeCheck_Changed"
                                      Content="{Binding [Crop_Mode], Source={x:Static local:Loc.Instance}}"
                                      ToolTip="{Binding [Crop_ModeTip], Source={x:Static local:Loc.Instance}}"/>
                            <CheckBox x:Name="ConfirmCheck" Checked="ConfirmCheck_Changed" Unchecked="ConfirmCheck_Changed"
                                      Content="{Binding [Review_Mode], Source={x:Static local:Loc.Instance}}"
                                      ToolTip="{Binding [Review_ModeTip], Source={x:Static local:Loc.Instance}}"/>
                        </WrapPanel>
                    </DockPanel>

                    <Grid>
                        <ListBox x:Name="WindowList" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="False">
                            <ListBox.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource MonitorGroupHeaderTemplate}"/>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Style="{StaticResource OtherMonitorDimRowStyle}">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"
                                                    Visibility="{Binding CropUiVisible, Converter={StaticResource BoolToVisibility}}">
                                            <CheckBox IsChecked="{Binding CropEnabled, Mode=TwoWay}" MinHeight="0" FontSize="12"
                                                      Style="{StaticResource RowCropCheckStyle}">
                                <CheckBox.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [Crop_Check], Source={x:Static local:Loc.Instance}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrandCyanBrush}"
                                                   ToolTip="{Binding [Crop_SavedTip], Source={x:Static local:Loc.Instance}}"
                                                   Visibility="{Binding HasSavedCrop, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </CheckBox.Content>
                            </CheckBox>
                                            <Button Padding="8,1" MinHeight="0" FontSize="11" Margin="4,0,0,0" Click="CropAdjust_Click"
                                                    Content="{Binding [Crop_Adjust], Source={x:Static local:Loc.Instance}}"
                                                    ToolTip="{Binding [Crop_AdjustTip], Source={x:Static local:Loc.Instance}}"
                                                    Visibility="{Binding CropEnabled, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                    Padding="6,2" MinHeight="0" MinWidth="0" Margin="8,0,0,0" Click="BringToFront_Click"
                                                    ToolTip="{Binding [Row_BringToFrontTip], Source={x:Static local:Loc.Instance}}"/>
                                        </StackPanel>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Display}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ScrollViewer x:Name="ThumbScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                      ScrollChanged="ThumbScroll_ScrollChanged">
                            <ItemsControl x:Name="ThumbList" ItemTemplate="{StaticResource ThumbnailTemplate}">
                                <!-- モニターごとのまとまりは縦に積み（GroupStyle の既定）、まとまりの中のカードは横に並べて折り返す -->
                                <ItemsControl.GroupStyle>
                                    <GroupStyle HeaderTemplate="{StaticResource MonitorGroupHeaderTemplate}"/>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 右: プレビューと設定 -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [Preview_Header], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid Height="170">
                            <Border x:Name="PreviewHost" CornerRadius="6" Background="#FF05070F"/>
                            <Border x:Name="PreviewEmpty" CornerRadius="6" Background="#FF05070F">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="Assets/empty-none.png" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding [Empty_Preview], Source={x:Static local:Loc.Instance}}" Margin="0,8,0,0" FontSize="12"
                                               Foreground="{StaticResource BrandSubtleTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource BrandSubtleTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                  <DockPanel>
                    <!-- 見出しの行はスクロールしない。右端に「特殊設定」（リモート連携など、使う人だけが開く設定） -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,14,0">
                        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Padding="10,2" MinHeight="0" FontSize="12" Click="AdvancedSettings_Click"
                                FocusVisualStyle="{x:Null}"
                                Content="{Binding [Settings_Advanced], Source={x:Static local:Loc.Instance}}"
                                ToolTip="{Binding [Settings_AdvancedTip], Source={x:Static local:Loc.Instance}}"/>
                        <TextBlock Text="{Binding [Settings_Header], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}"/>
                    </DockPanel>
                    <!-- 枠自体はフォーカスを受けない（Alt を押したときに設定欄が白い線で囲まれないように） -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <!-- 右端は細いスクロールバーが重なるので空けておく（色相バーをつかんだつもりでスクロールしないように） -->
                        <StackPanel Margin="0,0,14,0">
                            <!-- マウスで使う欄なので、Alt を押してもフォーカスの線は出さない（端で欠けて見えるので） -->
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                </Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                </Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                </Style>
                                <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                </Style>
                            </StackPanel.Resources>

                            <TextBlock TextWrapping="Wrap" Text="{Binding [Monitor_Label], Source={x:Static local:Loc.Instance}}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="MonitorCombo" HorizontalAlignment="Stretch" SelectionChanged="MonitorCombo_SelectionChanged"/>

                            <TextBlock TextWrapping="Wrap" Text="{Binding [Background_Label], Source={x:Static local:Loc.Instance}}" Margin="0,12,0,4"/>
                            <ComboBox x:Name="BackgroundCombo" HorizontalAlignment="Stretch" SelectionChanged="BackgroundCombo_SelectionChanged"/>
                            <!-- 単色の色: [色を選ぶ] ■ #RRGGBB。「単色」以外では押せない。押すとむにむにのポップアップ -->
                            <StackPanel x:Name="SolidColorRow" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="PickColorButton" Padding="12,4" Click="PickColor_Click"
                                        Content="{Binding [Background_PickColor], Source={x:Static local:Loc.Instance}}"/>
                                <Border x:Name="SolidColorSwatch" Width="20" Height="20" CornerRadius="4" Margin="12,0,0,0"
                                        BorderThickness="1" BorderBrush="#80FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SolidColorText" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=PickColorButton}" Placement="Bottom"
                                   VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" Opened="ColorPopup_Opened">
                                <Border Background="{StaticResource BrandPanelBrush}" BorderBrush="{StaticResource BrandBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Width="300">
                                    <!-- ドラッグ中は相手の画面にその場で反映し、離したら保存する -->
                                    <controls:HsvColorPicker x:Name="BackgroundColorPicker"/>
                                </Border>
                            </Popup>

                            <TextBlock TextWrapping="Wrap" Text="{Binding [Placement_Header], Source={x:Static local:Loc.Instance}}" Margin="0,12,0,4"/>
                            <!-- リモート連携の子として動いている間だけ出す（そのあいだ配置は押せない） -->
                            <TextBlock x:Name="PlacementChildNote" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4" Visibility="Collapsed"
                                       Foreground="{StaticResource BrandSubtleTextBrush}"
                                       Text="{Binding [Placement_ChildNote], Source={x:Static local:Loc.Instance}}"/>
                            <RadioButton x:Name="PlacementBack" Content="{Binding [Placement_Back], Source={x:Static local:Loc.Instance}}" IsChecked="True" Checked="Placement_Checked"/>
                            <RadioButton x:Name="PlacementNormal" Content="{Binding [Placement_Normal], Source={x:Static local:Loc.Instance}}" Checked="Placement_Checked"/>
                            <RadioButton x:Name="PlacementOffScreen" Checked="Placement_Checked">
                                <!-- 補足（Zoom は画面外だと共有が止まる）はほかの補足と同じ小さめの薄い文字で -->
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding [Placement_OffScreen], Source={x:Static local:Loc.Instance}, Mode=OneWay}"/>
                                    <Run Text="{Binding [Placement_OffScreenNote], Source={x:Static local:Loc.Instance}, Mode=OneWay}"
                                         FontSize="12" Foreground="{StaticResource BrandSubtleTextBrush}"/>
                                </TextBlock>
                            </RadioButton>

                            <CheckBox x:Name="OverlayCheck" Margin="0,12,0,0" IsChecked="True" Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed">
                                <TextBlock Text="{Binding [Option_Overlay], Source={x:Static local:Loc.Instance}}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="CursorCheck" IsChecked="True" Checked="CursorCheck_Changed" Unchecked="CursorCheck_Changed">
                                <TextBlock Text="{Binding [Option_Cursor], Source={x:Static local:Loc.Instance}}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="PopupCheck" IsChecked="True" Checked="PopupCheck_Changed" Unchecked="PopupCheck_Changed">
                                <TextBlock Text="{Binding [Option_Popups], Source={x:Static local:Loc.Instance}}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="TooltipCheck" IsChecked="True" Checked="TooltipCheck_Changed" Unchecked="TooltipCheck_Changed">
                                <TextBlock Text="{Binding [Option_Tooltips], Source={x:Static local:Loc.Instance}}" TextWrapping="Wrap"/>
                            </CheckBox>

                            <TextBlock TextWrapping="Wrap" Text="{Binding [Language_Label], Source={x:Static local:Loc.Instance}}" Margin="0,12,0,4"/>
                            <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Stretch" SelectionChanged="LanguageCombo_SelectionChanged"/>

                            <!-- 後片付け: 設定とログを消して、何も残さず終了する -->
                            <Button x:Name="DeleteDataButton" Margin="0,20,0,0" HorizontalAlignment="Stretch" Padding="12,6"
                                    Background="#FFC42B1C" Foreground="White" Click="DeleteData_Click"
                                    Content="{Binding [Settings_DeleteData], Source={x:Static local:Loc.Instance}}"
                                    ToolTip="{Binding [Settings_DeleteDataTip], Source={x:Static local:Loc.Instance}}"/>
                        </StackPanel>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
            </DockPanel>
        </Grid>

        <!-- コンパクト表示 -->
        <DockPanel x:Name="CompactView" Grid.Row="1" Visibility="Collapsed">
            <!-- 一番下の 1 行: 左に「上をクロップ」（通常表示のものと連動）、右の残り幅いっぱいに「クリックで選択」 -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <CheckBox x:Name="CompactCropModeCheck" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center"
                          Checked="CropModeCheck_Changed" Unchecked="CropModeCheck_Changed"
                          Content="{Binding [Crop_Mode], Source={x:Static local:Loc.Instance}}"
                          ToolTip="{Binding [Crop_ModeTip], Source={x:Static local:Loc.Instance}}"/>
                <Button x:Name="CompactSelectButton" HorizontalAlignment="Stretch"
                        Padding="12,8" Background="{StaticResource BrandBlueBrush}" Foreground="White" Click="CompactSelect_Click"
                        ToolTip="{Binding [Toolbar_SelectTip], Source={x:Static local:Loc.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding [Toolbar_Select], Source={x:Static local:Loc.Instance}}"/>
                    </StackPanel>
                </Button>
            </DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,10">
                <Grid Height="140">
                    <Border x:Name="CompactPreviewHost" CornerRadius="6" Background="#FF05070F"/>
                    <Border x:Name="CompactPreviewEmpty" CornerRadius="6" Background="#FF05070F">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="Assets/empty-none.png" Height="84" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding [Empty_PreviewShort], Source={x:Static local:Loc.Instance}}" Margin="0,6,0,0" FontSize="12"
                                       Foreground="{StaticResource BrandSubtleTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 共有するモニターの切り替え（モニターの絵に番号。2 枚以上のときだけ、最大 4 つ。中身はコードで作る） -->
                    <StackPanel x:Name="CompactMonitorPanel" Orientation="Horizontal" Margin="0,0,4,0"/>
                    <Button x:Name="CompactBringAllButton" Content="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                            Padding="6,3" MinHeight="0" MinWidth="0" Margin="0,0,4,0" Click="BringAllToFront_Click"
                            ToolTip="{Binding [BringAllToFrontTip], Source={x:Static local:Loc.Instance}}"/>
                    <Button x:Name="CompactUncheckAllButton" Content="&#xE894;" FontFamily="{StaticResource IconFont}" FontSize="12"
                            Padding="6,3" MinHeight="0" MinWidth="0" Click="UncheckAll_Click"
                            ToolTip="{Binding [UncheckAll], Source={x:Static local:Loc.Instance}}"/>
                </StackPanel>
                <TextBlock Text="{Binding [Shared_Header], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}"
                           Margin="0" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="CompactStatusText" DockPanel.Dock="Bottom" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource BrandSubtleTextBrush}"/>
            <StackPanel x:Name="CompactUndoBar" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                <TextBlock Text="{Binding [Undo_Removed], Source={x:Static local:Loc.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                <Button Margin="8,0,0,0" Padding="10,2" MinHeight="0" FontSize="12" Click="Undo_Click"
                        Content="{Binding [Undo_Button], Source={x:Static local:Loc.Instance}}"/>
            </StackPanel>
            <Grid>
            <StackPanel x:Name="CompactSharedEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="Assets/empty-select.png" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding [Empty_Shared], Source={x:Static local:Loc.Instance}}" Margin="0,6,0,0" FontSize="12"
                           Foreground="{StaticResource BrandSubtleTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl x:Name="SharedChips" ItemTemplate="{StaticResource ChipTemplate}">
                    <!-- コンパクトは区切り線なし（うるさくなるので）。並び順と薄さだけで分ける -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
