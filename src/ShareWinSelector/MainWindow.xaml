<Window x:Class="ShareWinSelector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShareWinSelector"
        Title="ShareWinSelector" Width="1000" Height="660" MinWidth="300" MinHeight="260"
        Icon="Assets/app.ico"
        Background="{StaticResource BrandWindowBackgroundBrush}">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ヘッダーのアイコンボタン -->
        <!-- Fluent テーマのスタイルを継承しないとライト用の古い見た目になる -->
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="IconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <!-- サムネイルのカード（チェック状態でシアンの縁） -->
        <Style x:Key="ThumbCardStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <!-- テンプレートを自前で持つので文字色も明示する（未指定だと暗い既定色になり読めない） -->
            <Setter Property="Foreground" Value="#FFF0F4FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Card" Background="{StaticResource BrandPanelBrush}" BorderBrush="{StaticResource BrandBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FF1B233A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrandCyanBrush}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Card" Property="Padding" Value="7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ThumbnailTemplate" DataType="{x:Type local:WindowItem}">
            <ToggleButton Style="{StaticResource ThumbCardStyle}" Width="212" Margin="0,0,10,10"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}" ToolTip="{Binding Display}">
                <StackPanel>
                    <!-- ここに DWM サムネイルが重なる -->
                    <Border Height="118" CornerRadius="6" Background="#FF080C18" Tag="{Binding Handle}"
                            Loaded="ThumbHost_Loaded" Unloaded="ThumbHost_Unloaded"/>
                    <DockPanel Margin="2,8,2,0">
                        <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                   Foreground="{StaticResource BrandCyanBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ProcessName}" Margin="2,2,2,0" FontSize="11"
                               Foreground="{StaticResource BrandSubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
                    <!-- このアプリのクロップ（「上をクロップ」がオンのときだけ） -->
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding CropUiVisible, Converter={StaticResource BoolToVisibility}}">
                        <Button DockPanel.Dock="Right" Content="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                Padding="6,2" MinHeight="0" MinWidth="0" Margin="4,0,0,0" Click="BringToFront_Click"
                                ToolTip="{Binding [Row_BringToFrontTip], Source={x:Static local:Loc.Instance}}"/>
                        <Button DockPanel.Dock="Right" Padding="8,1" MinHeight="0" FontSize="11" Click="CropAdjust_Click"
                                Content="{Binding [Crop_Adjust], Source={x:Static local:Loc.Instance}}"
                                ToolTip="{Binding [Crop_AdjustTip], Source={x:Static local:Loc.Instance}}"
                                Visibility="{Binding CropEnabled, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding CropEnabled, Mode=TwoWay}" MinHeight="0" FontSize="11" VerticalAlignment="Center"
                                      ToolTip="{Binding [Crop_CheckTip], Source={x:Static local:Loc.Instance}}">
                                <CheckBox.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [Crop_Check], Source={x:Static local:Loc.Instance}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrandCyanBrush}"
                                                   ToolTip="{Binding [Crop_SavedTip], Source={x:Static local:Loc.Instance}}"
                                                   Visibility="{Binding HasSavedCrop, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </CheckBox.Content>
                            </CheckBox>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ToggleButton>
        </DataTemplate>

        <!-- 共有中ウィンドウのチップ（コンパクト表示） -->
        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type local:WindowItem}">
            <Border Background="#FF14304A" BorderBrush="{StaticResource BrandCyanBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="10,3,4,3" Margin="0,0,6,6" ToolTip="{Binding Display}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button Content="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10" Padding="4" Margin="6,0,0,0"
                            MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                            ToolTip="{Binding [Row_BringToFrontTip], Source={x:Static local:Loc.Instance}}" Click="BringToFront_Click"/>
                    <Button Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" Padding="4" Margin="0"
                            MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                            ToolTip="{Binding [Chip_RemoveTip], Source={x:Static local:Loc.Instance}}" Click="ChipRemove_Click"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16,10,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー: ロゴ ＋ ピン留め・表示切替 -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggleStyle}" Content="&#xE77A;"
                              ToolTip="{Binding [Header_PinTip], Source={x:Static local:Loc.Instance}}"
                              Checked="PinButton_Changed" Unchecked="PinButton_Changed"/>
                <Button x:Name="ModeButton" Style="{StaticResource IconButtonStyle}" Content="&#xE73F;"
                        ToolTip="{Binding [Header_CompactTip], Source={x:Static local:Loc.Instance}}" Click="ModeButton_Click"/>
            </StackPanel>
            <Image x:Name="LogoImage" Source="Assets/logo.png" Height="44" HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </DockPanel>

        <!-- 通常表示 -->
        <Grid x:Name="NormalView" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- 左: ウィンドウ選択 -->
            <Border Style="{StaticResource CardStyle}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton x:Name="MonitorOnlyButton" Style="{StaticResource IconToggleStyle}" Content="&#xE7F4;" Margin="0,0,12,0"
                                          ToolTip="{Binding [View_MonitorOnlyTip], Source={x:Static local:Loc.Instance}}" Checked="MonitorOnlyButton_Changed" Unchecked="MonitorOnlyButton_Changed"/>
                            <ToggleButton x:Name="ListViewButton" Style="{StaticResource IconToggleStyle}" Content="&#xE8FD;"
                                          ToolTip="{Binding [View_ListTip], Source={x:Static local:Loc.Instance}}" Click="ViewButton_Click"/>
                            <ToggleButton x:Name="ThumbViewButton" Style="{StaticResource IconToggleStyle}" Content="&#xE8A9;"
                                          ToolTip="{Binding [View_ThumbnailsTip], Source={x:Static local:Loc.Instance}}" Click="ViewButton_Click"/>
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Margin="12,0,0,0"
                                    ToolTip="{Binding [Refresh], Source={x:Static local:Loc.Instance}}" Click="Refresh_Click"/>
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE894;"
                                    ToolTip="{Binding [UncheckAll], Source={x:Static local:Loc.Instance}}" Click="UncheckAll_Click"/>
                        </StackPanel>
                        <TextBlock Text="{Binding [Windows_Header], Source={x:Static local:Loc.Instance}}"
                                   Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- 共有のしかた（全体） -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox x:Name="CropModeCheck" Margin="0,0,20,0" Checked="CropModeCheck_Changed" Unchecked="CropModeCheck_Changed"
                                  Content="{Binding [Crop_Mode], Source={x:Static local:Loc.Instance}}"
                                  ToolTip="{Binding [Crop_ModeTip], Source={x:Static local:Loc.Instance}}"/>
                        <CheckBox x:Name="ConfirmCheck" Checked="ConfirmCheck_Changed" Unchecked="ConfirmCheck_Changed"
                                  Content="{Binding [Review_Mode], Source={x:Static local:Loc.Instance}}"
                                  ToolTip="{Binding [Review_ModeTip], Source={x:Static local:Loc.Instance}}"/>
                    </WrapPanel>

                    <Grid>
                        <ListBox x:Name="WindowList" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"
                                                    Visibility="{Binding CropUiVisible, Converter={StaticResource BoolToVisibility}}">
                                            <CheckBox IsChecked="{Binding CropEnabled, Mode=TwoWay}" MinHeight="0" FontSize="12"
                                                      ToolTip="{Binding [Crop_CheckTip], Source={x:Static local:Loc.Instance}}">
                                <CheckBox.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [Crop_Check], Source={x:Static local:Loc.Instance}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrandCyanBrush}"
                                                   ToolTip="{Binding [Crop_SavedTip], Source={x:Static local:Loc.Instance}}"
                                                   Visibility="{Binding HasSavedCrop, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </CheckBox.Content>
                            </CheckBox>
                                            <Button Padding="8,1" MinHeight="0" FontSize="11" Margin="4,0,0,0" Click="CropAdjust_Click"
                                                    Content="{Binding [Crop_Adjust], Source={x:Static local:Loc.Instance}}"
                                                    ToolTip="{Binding [Crop_AdjustTip], Source={x:Static local:Loc.Instance}}"
                                                    Visibility="{Binding CropEnabled, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                    Padding="6,2" MinHeight="0" MinWidth="0" Margin="8,0,0,0" Click="BringToFront_Click"
                                                    ToolTip="{Binding [Row_BringToFrontTip], Source={x:Static local:Loc.Instance}}"/>
                                        </StackPanel>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Display}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ScrollViewer x:Name="ThumbScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      ScrollChanged="ThumbScroll_ScrollChanged">
                            <ItemsControl x:Name="ThumbList" ItemTemplate="{StaticResource ThumbnailTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 右: プレビューと設定 -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [Preview_Header], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid Height="170">
                            <Border x:Name="PreviewHost" CornerRadius="6" Background="#FF05070F"/>
                            <Border x:Name="PreviewEmpty" CornerRadius="6" Background="#FF05070F">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="Assets/empty-none.png" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding [Empty_Preview], Source={x:Static local:Loc.Instance}}" Margin="0,8,0,0" FontSize="12"
                                               Foreground="{StaticResource BrandSubtleTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource BrandSubtleTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding [Settings_Header], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}"/>

                            <TextBlock Text="{Binding [Monitor_Label], Source={x:Static local:Loc.Instance}}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="MonitorCombo" HorizontalAlignment="Stretch" SelectionChanged="MonitorCombo_SelectionChanged"/>

                            <TextBlock Text="{Binding [Background_Label], Source={x:Static local:Loc.Instance}}" Margin="0,12,0,4"/>
                            <ComboBox x:Name="BackgroundCombo" HorizontalAlignment="Stretch" SelectionChanged="BackgroundCombo_SelectionChanged"/>

                            <TextBlock Text="{Binding [Placement_Header], Source={x:Static local:Loc.Instance}}" Margin="0,12,0,4"/>
                            <RadioButton x:Name="PlacementBack" Content="{Binding [Placement_Back], Source={x:Static local:Loc.Instance}}" IsChecked="True" Checked="Placement_Checked"/>
                            <RadioButton x:Name="PlacementNormal" Content="{Binding [Placement_Normal], Source={x:Static local:Loc.Instance}}" Checked="Placement_Checked"/>
                            <RadioButton x:Name="PlacementOffScreen" Checked="Placement_Checked">
                                <!-- 補足（Zoom は画面外だと共有が止まる）はほかの補足と同じ小さめの薄い文字で -->
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding [Placement_OffScreen], Source={x:Static local:Loc.Instance}, Mode=OneWay}"/>
                                    <Run Text="{Binding [Placement_OffScreenNote], Source={x:Static local:Loc.Instance}, Mode=OneWay}"
                                         FontSize="12" Foreground="{StaticResource BrandSubtleTextBrush}"/>
                                </TextBlock>
                            </RadioButton>

                            <CheckBox x:Name="OverlayCheck" Margin="0,12,0,0" IsChecked="True" Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed">
                                <TextBlock Text="{Binding [Option_Overlay], Source={x:Static local:Loc.Instance}}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="CursorCheck" IsChecked="True" Checked="CursorCheck_Changed" Unchecked="CursorCheck_Changed">
                                <TextBlock Text="{Binding [Option_Cursor], Source={x:Static local:Loc.Instance}}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="PopupCheck" IsChecked="True" Checked="PopupCheck_Changed" Unchecked="PopupCheck_Changed">
                                <TextBlock Text="{Binding [Option_Popups], Source={x:Static local:Loc.Instance}}" TextWrapping="Wrap"/>
                            </CheckBox>

                            <TextBlock Text="{Binding [Language_Label], Source={x:Static local:Loc.Instance}}" Margin="0,12,0,4"/>
                            <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Stretch" SelectionChanged="LanguageCombo_SelectionChanged"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>

        <!-- コンパクト表示 -->
        <DockPanel x:Name="CompactView" Grid.Row="1" Visibility="Collapsed">
            <Button x:Name="CompactSelectButton" DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                    Padding="12,8" Background="{StaticResource BrandBlueBrush}" Foreground="White" Click="CompactSelect_Click"
                    ToolTip="{Binding [Toolbar_SelectTip], Source={x:Static local:Loc.Instance}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding [Toolbar_Select], Source={x:Static local:Loc.Instance}}"/>
                </StackPanel>
            </Button>
            <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,10">
                <Grid Height="140">
                    <Border x:Name="CompactPreviewHost" CornerRadius="6" Background="#FF05070F"/>
                    <Border x:Name="CompactPreviewEmpty" CornerRadius="6" Background="#FF05070F">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="Assets/empty-none.png" Height="84" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding [Empty_PreviewShort], Source={x:Static local:Loc.Instance}}" Margin="0,6,0,0" FontSize="12"
                                       Foreground="{StaticResource BrandSubtleTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <TextBlock DockPanel.Dock="Top" Text="{Binding [Shared_Header], Source={x:Static local:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock x:Name="CompactStatusText" DockPanel.Dock="Bottom" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource BrandSubtleTextBrush}"/>
            <Grid>
            <StackPanel x:Name="CompactSharedEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="Assets/empty-select.png" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding [Empty_Shared], Source={x:Static local:Loc.Instance}}" Margin="0,6,0,0" FontSize="12"
                           Foreground="{StaticResource BrandSubtleTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SharedChips" ItemTemplate="{StaticResource ChipTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
